# Node.js dependencies
# Directory where npm packages are installed.
node_modules/

# Log files
# General log files.
*.log
# npm debug log files.
npm-debug.log*
# Yarn debug log files.
yarn-debug.log*
yarn-error.log*

# Environment variables
# Local environment variables, often used for development configuration.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Build artifacts
# Directories where compiled or bundled output might be placed.
# While this project is simple HTML/CSS/JS, these are common for future build steps.
/dist
/build

# Editor/IDE specific files
# Configuration files generated by various Integrated Development Environments.
# Visual Studio Code
.vscode/
# JetBrains IDEs (e.g., WebStorm, IntelliJ IDEA)
.idea/
# Sublime Text project files
*.sublime-project
*.sublime-workspace
# Atom editor files
.atom/

# OS generated files
# Files automatically created by operating systems.
# macOS
.DS_Store
# Windows
Thumbs.db

# Temporary files
# Common temporary files created by editors or system processes.
*~
#*#
*.swp
*.swo